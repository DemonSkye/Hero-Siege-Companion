{
  "name": "hero-siege-companion",
  "productName": "Hero Siege Companion",
  "version": "0.2.2",
  "private": true,
  "description": "Electron + Vue companion app for passive Hero Siege stat tracking.",
  "main": "dist/main/main/main.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "dist:win": "npm run prepare:cap && npm run build && electron-builder --win portable --x64 --publish=never",
    "prepare:cap": "node scripts/prepare-cap-native.js",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:electron": "npm run build && playwright test -c playwright.electron.config.cjs",
    "test:watch": "vitest",
    "rebuild": "electron-rebuild -f -w cap",
    "postinstall:electron": "node ./node_modules/electron/install.js"
  },
  "build": {
    "appId": "com.herosiege.companion",
    "productName": "Hero Siege Companion",
    "asar": true,
    "asarUnpack": [
      "node_modules/cap/build/Release/cap.node"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "../"
    },
    "files": [
      "dist/**/*",
      "icon.jpg",
      "icon.ico",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Hero Siege Companion.exe"
    }
  },
  "dependencies": {
    "cap": "^0.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "^22.15.21",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "2.4.10",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "jsdom": "29.1.1",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vitest": "4.1.7",
    "vue": "^3.5.14"
  }
}
